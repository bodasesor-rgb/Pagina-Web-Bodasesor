# Copia a .env.local (no se sube a git)
NETLIFY_AUTH_TOKEN=tu_token_de_netlify
NETLIFY_SITE_ID=tu_api_id_del_sitio
# Alternativa más fácil — solo dispara build desde Git (Netlify → Build hooks):
# NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/...

# Obtener token: https://app.netlify.com/user/applications#personal-access-tokens
# Obtener site ID: Netlify → Site configuration → General → API ID

# ── Gemini (Pagina Web chat + city hubs) — corte de costo V9.32-web ───────────
# GEMINI_API_KEY=   # o GEMINI_IA / gemini_ia
GEMINI_MODEL=gemini-3.1-flash-lite
# Explicit context cache: OFF por defecto (evita thrashing).
GEMINI_CONTEXT_CACHE=0
# GEMINI_CONTEXT_CACHE_TTL_SEC=3600
# 1 llamada LLM por mensaje de chat (ya unificado; flag de paridad con Lucy).
LUCY_UNIFIED_LLM_TURN=1
# Historial enviado al LLM (últimos N user/model).
LUCY_CHAT_HISTORY_MAX=6
# Few-shot (0 = no inyectar ejemplos).
LUCY_FEW_SHOT_MAX=0
# Nunca generar imágenes en chat salvo jobs offline explícitos:
# GEMINI_ALLOW_IMAGE_GEN=1
